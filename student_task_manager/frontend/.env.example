# Copy to .env (local dev) or .env.production (production build).
# CRA bakes these into the JS bundle at build time — there is no
# runtime override, so .env.production must exist with the real
# Azure App Service URL before you run `npm run build` for deployment.
# In CI, these are instead injected as env vars during the GitHub Actions
# build step (see .github/workflows/azure-static-web-apps.yml).

REACT_APP_GOOGLE_CLIENT_ID=536106975589-2c1se0n3oa42duhtikdp4icg096cup3k.apps.googleusercontent.com

# Local dev default. For production, set this to your deployed
# Azure App Service URL, e.g. https://task-manager-backend.azurewebsites.net
REACT_APP_API_URL=http://127.0.0.1:8000
