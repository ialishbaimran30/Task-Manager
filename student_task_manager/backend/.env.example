# Copy to .env and fill in real values. Never commit the real .env file.

# --- Django core ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS / CSRF (comma-separated origins, no trailing slash) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Database (Azure Database for PostgreSQL - Flexible Server in production) ---
# Local dev: point at a local Postgres instance.
# Production: use your Azure Database for PostgreSQL connection details
# (Azure Portal -> your PostgreSQL server -> Connect). Azure enforces SSL
# by default, so DB_SSLMODE should be "require" in production.
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# --- Google OAuth ---
GOOGLE_CLIENT_ID=

# --- Email (OTP delivery) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
